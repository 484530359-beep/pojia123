[Unit]
Description=寒霜破甲工具 Playground 运行结果接收服务
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=hanshuang-upload
Group=hanshuang-upload
WorkingDirectory=/opt/hanshuang-playground
ExecStart=/usr/bin/python3 /opt/hanshuang-playground/playground_receiver.py
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/hanshuang-playground
Environment=HS_UPLOAD_HOST=0.0.0.0
Environment=HS_UPLOAD_PORT=18400
Environment=HS_UPLOAD_ROOT=/var/lib/hanshuang-playground

[Install]
WantedBy=multi-user.target
